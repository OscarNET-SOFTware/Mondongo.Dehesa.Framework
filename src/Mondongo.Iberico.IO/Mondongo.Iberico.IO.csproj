<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>I/O library for optimized and improved file system operations. This library is part of Mondongo Dehesa Framework.</AssemblyTitle>
    <Description>$(AssemblyTitle)</Description>
    <PackageId>Mondongo.Iberico.IO</PackageId>
    <PackageTags>oscarnet mondongo dehesa framework iberico io</PackageTags>
    <Title>Mondongo Iberico IO (part of Mondongo Dehesa Framework)</Title>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mondongo.Iberico.IO.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mondongo.Iberico.Extensions\Mondongo.Iberico.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\IOResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IOResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\IOResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>IOResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
