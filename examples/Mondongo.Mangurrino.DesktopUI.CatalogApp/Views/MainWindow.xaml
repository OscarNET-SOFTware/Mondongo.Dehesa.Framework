<Window x:Class="Mondongo.Mangurrino.DesktopUI.CatalogApp.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mondongo.Mangurrino.DesktopUI.CatalogApp"
        xmlns:localViews="clr-namespace:Mondongo.Mangurrino.DesktopUI.CatalogApp.Views"
        xmlns:localViewModels="clr-namespace:Mondongo.Mangurrino.DesktopUI.CatalogApp.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>

        <!-- Left panel with list of controls -->
        <ListBox DockPanel.Dock="Left" Width="200"
                 ItemsSource="{Binding Controls}"
                 SelectedItem="{Binding SelectedControl}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right panel for properties (binding demo) -->
        <StackPanel DockPanel.Dock="Right" Width="250" Margin="5">
            <TextBlock FontWeight="Bold" Text="Properties" Margin="0,0,0,10"/>
            <ContentControl Content="{Binding SelectedControl}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type localViewModels:TextFieldViewModel}">
                        <StackPanel>
                            <TextBlock Text="Display Name:"/>
                            <TextBlock Text="{Binding Name, Mode=OneTime}" Margin="0,0,0,10" />

                            <TextBlock Text="LabelBackground" />
                            <ComboBox ItemsSource="{Binding AllBrushes, Mode=OneTime}"
                                      Margin="0,0,0,10"
                                      SelectedValue="{Binding SelectedLabelBackground, Mode=TwoWay}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ContentTemplateSelector"
                                                Value="{x:Null}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Height="16"
                                                       Fill="{Binding Value}"
                                                       Margin="0,0,5,0"
                                                       Stroke="Transparent"
                                                       Width="16" />
                                            <TextBlock Text="{Binding Key}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="LabelForeground" />
                            <ComboBox ItemsSource="{Binding AllBrushes, Mode=OneTime}"
                                      Margin="0,0,0,10"
                                      SelectedValue="{Binding SelectedLabelForeground, Mode=TwoWay}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ContentTemplateSelector"
                                                Value="{x:Null}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Height="16"
                                                       Fill="{Binding Value}"
                                                       Margin="0,0,5,0"
                                                       Stroke="Transparent"
                                                       Width="16" />
                                            <TextBlock Text="{Binding Key}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="LabelPosition" />
                            <ComboBox ItemsSource="{Binding LabelPositions, Mode=OneTime}"
                                      Margin="0,0,0,10"
                                      SelectedValue="{Binding SelectedLabelPosition, Mode=TwoWay}" />

                            <TextBlock Text="LabelText"/>
                            <TextBox Text="{Binding SelectedLabelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="LabelTextAlignment" />
                            <ComboBox ItemsSource="{Binding LabelTextAlignments, Mode=OneTime}"
                                      Margin="0,0,0,10"
                                      SelectedValue="{Binding SelectedLabelTextAlignment, Mode=TwoWay}" />

                            <TextBlock Text="Is Enabled:"/>
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </StackPanel>

        <!-- Central dynamic view -->
        <ContentControl Content="{Binding SelectedControl}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type localViewModels:TextFieldViewModel}">
                    <localViews:TextFieldView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

    </DockPanel>
</Window>
