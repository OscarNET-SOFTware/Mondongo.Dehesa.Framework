<UserControl x:Class="Mondongo.Mangurrino.DesktopUI.CatalogApp.Views.TextFieldView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mondongo.Mangurrino.DesktopUI.CatalogApp.Views"
             xmlns:mondongo="http://schemas.mondongo.com/mangurrino/desktopui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="10">
        <TextBlock FontWeight="Bold"
                   Margin="0,0,0,8"
                   Text="{Binding Name, Mode=OneTime}" />
        <mondongo:TextField IsEnabled="{Binding IsEnabled, Mode=OneWay}"
                            FieldBackground="{Binding SelectedFieldBackground, Mode=OneWay}"
                            FieldBackgroundWhenGotFocus="{Binding SelectedFieldBackgroundWhenGotFocus, Mode=OneWay}"
                            FieldBackgroundWhenIsDisabled="{Binding SelectedFieldBackgroundWhenIsDisabled, Mode=OneWay}"
                            FieldBorderBrush="{Binding SelectedFieldBorderBrush, Mode=OneWay}"
                            FieldBorderBrushWhenGotFocus="{Binding SelectedFieldBorderBrushWhenGotFocus, Mode=OneWay}"
                            FieldBorderBrushWhenIsDisabled="{Binding SelectedFieldBorderBrushWhenIsDisabled, Mode=OneWay}"
                            FieldForeground="{Binding SelectedFieldForeground, Mode=OneWay}"
                            FieldForegroundWhenGotFocus="{Binding SelectedFieldForegroundWhenGotFocus, Mode=OneWay}"
                            FieldForegroundWhenIsDisabled="{Binding SelectedFieldForegroundWhenIsDisabled, Mode=OneWay}"
                            LabelBackground="{Binding SelectedLabelBackground, Mode=OneWay}"
                            LabelForeground="{Binding SelectedLabelForeground, Mode=OneWay}"
                            LabelPosition="{Binding SelectedLabelPosition, Mode=OneWay}"
                            LabelText="{Binding SelectedLabelText, Mode=OneWay}"
                            LabelTextAlignment="{Binding SelectedLabelTextAlignment, Mode=OneWay}" />
    </StackPanel>
</UserControl>
