root = true

[*]
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.{config,json,nuspec,props,resx,ruleset,targets,vsct,vsixmanifest,xml}]
indent_size = 2

[*.cs]
max_line_length = 120

[*.sh]
end_of_line = lf

[*.sln]
indent_style = tab